# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized
# and converted to native line endings on checkout.
*.txt text diff=text
/android/cts/master/vk-master.txt filter=lfs diff=lfs merge=lfs -text
/external/vulkancts/mustpass/master/vk-default.txt filter=lfs diff=lfs merge=lfs -text
